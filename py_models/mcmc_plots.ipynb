    "from scipy.sparse import csr_matrix\n",
    "from scipy.sparse.csgraph import connected_components\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# CONFIG\n",
    "# ================================================================\n",
    "\n",
    "BASE_DIR = Path(r\"D:\\77\\Research\\temp\\snow\")\n",
    "\n",
    "good_chains = [0,1,2,3,4]\n",
    "\n",
    "period = 52\n",
    "\n",
    "\n",
    "# ================================================================\n",
